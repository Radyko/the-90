# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are PUBLIC by design (shipped to the browser). Security is enforced by
# Postgres Row-Level Security (see supabase/schema.sql), not by hiding these.
# NEVER put the service_role / secret key here or anywhere in this repo.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
